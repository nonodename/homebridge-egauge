{
  "pluginAlias": "HomeBridgeEgauge",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "eGauge Energy Sensor"
      }, 
      "server":{
        "title": "Server IP",
        "type": "string",
        "required": true,
        "default": "192.168.1.1"    
      },
      "username":{
        "title": "Username",
        "type": "string",
        "required": true 
      },
      "password":{
        "title": "Password",
        "type": "string",
        "required": true   
      },
      "registers":{
        "title": "Registers to Read",
        "type": "string",
        "required": false   
      },
      "hap":{
        "title": "Expose as HomeKit light sensors",
        "description": "Lightbulb + light sensor pair per register (lux = watts). Works on all Homebridge versions.",
        "type": "boolean",
        "default": true
      },
      "matter":{
        "title": "Expose as Matter electrical sensors",
        "description": "Requires Homebridge 2 with Matter enabled on this bridge. Only power registers are exposed.",
        "type": "boolean",
        "default": true
      }
    }
  }
}